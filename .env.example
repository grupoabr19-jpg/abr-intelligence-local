# Supabase1 - frontend/publico
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase2 - frontend/publico - CRM/atendimento
VITE_SUPABASE_CRM_URL=
VITE_SUPABASE_CRM_PUBLISHABLE_KEY=

# Supabase1 - backend/servicos - empresa/dashboard
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Supabase1 - Postgres
# Use o Transaction Pooler IPv4 do Dashboard do Supabase.
# Exemplo:
# DATABASE_URL_POOLER=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL_POOLER=
DATABASE_URL=
SUPABASE_PASSWORD=

# Supabase2 - backend/servicos - CRM/atendimento
SUPABASE_CRM_URL=
SUPABASE_CRM_PUBLISHABLE_KEY=
SUPABASE_CRM_SECRET_KEY=
SUPABASE_CRM_JWKS_URL=

# Supabase2 - Postgres - CRM/atendimento
DATABASE_CRM_URL_POOLER=
DATABASE_CRM_URL=
SUPABASE_CRM_PASSWORD=

# Neon - Postgres - Mercado
# Use apenas no backend. Nao exponha URL de banco em variavel VITE_*.
DATABASE_NEON_URL_POOLER=
DATABASE_NEON_URL=

# Aster - usar apenas no backend/coletor, nunca no frontend
ASTER_BASE_URL=https://aster.gruposps.com.br/Login/abr
ASTER_LOGIN_EMAIL=
ASTER_LOGIN_PASSWORD=
HEADLESS=true

# Ingestao ABR para coletor Python/extensao Aster
ABR_INGEST_URL=https://<project-ref>.supabase.co/functions/v1/abr-collector-ingest
ABR_COLLECTOR_KEY=
ABR_ASTER_FONTE_ID=
ABR_ASTER_ENTIDADE=aster_relatorio

# API backend FastAPI
ABR_API_KEY=
VITE_ABR_API_KEY=

# Render para o backend
# O dashboard web fica aberto; estas variaveis mantem sessao/cookies e compatibilidade.
ABR_DASHBOARD_PASSWORD=
ABR_SESSION_SECRET=
# Atualizacao diaria sem Cron pago:
# true = primeira abertura do dashboard no dia dispara a coleta D-1; depois so manual.
ABR_ENABLE_WEB_AUTO_REFRESH=true
ABR_ENABLE_WEB_REFRESH_JOBS=true
# Usado apenas se ABR_ENABLE_WEB_AUTO_REFRESH=true. Mantem verificacao leve em segundo plano.
ABR_AUTO_REFRESH_START_DELAY_SECONDS=20
ABR_AUTO_REFRESH_CHECK_SECONDS=1800
# Probe curto do Supabase1/Core antes de persistir status do refresh.
ABR_CORE_PROBE_TIMEOUT_SECONDS=3

# Opcional: endpoint/segredo da integracao oficial do Aster, quando disponibilizado pelo fornecedor
ASTER_API_BASE_URL=
ASTER_API_TOKEN=

# Planilha de ingestao secundaria
GOOGLE_SHEETS_SECUNDARIA=
GOOGLE_SHEETS_TOKEN=

# Archive bruto - Google Drive
# Pasta validada: archive do abr intelligence
ARCHIVE_STORAGE_PROVIDER=google_drive
ARCHIVE_LOCAL_DIR=archive
ARCHIVE_WRITE_LOCAL_COPY=true
# Se true, uma falha no upload/catalogo do Drive derruba a coleta. Padrao recomendado: false.
ARCHIVE_FAIL_ON_DRIVE_ERROR=false
ARCHIVE_GOOGLE_DRIVE_FOLDER_ID=1Tgc2ea8hdNgo9ReLT04bAT2PSvzsmR8W
ARCHIVE_GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1Tgc2ea8hdNgo9ReLT04bAT2PSvzsmR8W
# Pasta de entrada das planilhas brutas mais atuais:
# margem, gestao da producao, estoque, envelhecimento de estoque e cotacoes.
DRIVE_SPREADSHEET_SOURCE_FOLDER_ID=1e-ZFOdh5PpIOjX1xFU87uhIKHveL5EpU
DRIVE_SPREADSHEET_SOURCE_FOLDER_URL=https://drive.google.com/drive/folders/1e-ZFOdh5PpIOjX1xFU87uhIKHveL5EpU
# Profundidade para procurar planilhas novas na pasta Archive.
# Padrao 1 = pasta raiz + subpastas imediatas.
DRIVE_SPREADSHEET_SCAN_DEPTH=1
# Mantem falso no plano gratis: o bruto fica no Drive e o banco recebe apenas controle/fatos compactos.
DRIVE_SPREADSHEET_STORE_RAW_ROWS=false
# OAuth usa a quota do usuario Google/Google One. Recomendado para Drive pessoal.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Service account e opcional. Em "Meu Drive" pessoal ela le a pasta, mas nao tem quota para upload.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# Fontes externas - mercado, macroeconomia e governo
# Use apenas no backend/coletor. A maioria e publica; tokens ficam vazios ate haver fornecedor/chave.
EXTERNAL_DATA_USER_AGENT=ABR-Intelligence/1.0
EXTERNAL_DATA_TIMEOUT_SECONDS=30

# BCB dolar/PTAX - API OData publica
BCB_DOLAR_API_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata

