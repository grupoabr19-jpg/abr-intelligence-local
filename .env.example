# Supabase - frontend/publico
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase - backend/servicos
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Supabase - Postgres
# Use o Transaction Pooler IPv4 do Dashboard do Supabase.
# O host direto db.<project-ref>.supabase.co depende de IPv6 em alguns planos/redes.
# Exemplo de formato recomendado:
# DATABASE_URL_POOLER=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL_POOLER=
# Opcional: pode ser a URL direta do Dashboard; os scripts montam o pooler IPv4 a partir dela.
DATABASE_URL=
SUPABASE_PASSWORD=

# Aster - usar apenas no backend/coletor, nunca no frontend
ASTER_BASE_URL=https://aster.gruposps.com.br/Login/abr
ASTER_LOGIN_EMAIL=
ASTER_LOGIN_PASSWORD=
HEADLESS=true

# Ingestao ABR para coletor Python/extensao Aster
# URL padrao depois do deploy da Edge Function abr-collector-ingest.
ABR_INGEST_URL=https://<project-ref>.supabase.co/functions/v1/abr-collector-ingest
# Chave longa gerada por voce e cadastrada tambem como secret da Edge Function.
ABR_COLLECTOR_KEY=
# Fonte seedada pela migration para ASTER ERP (SPS Group):
# a0000000-0000-4000-8000-000000000001
ABR_ASTER_FONTE_ID=
ABR_ASTER_ENTIDADE=aster_relatorio

# API backend FastAPI
# Se preenchida, toda rota /v1 exige header: x-api-key: <valor>
ABR_API_KEY=
PORT=8000

# Opcional: endpoint/segredo da integracao oficial, quando disponibilizado pelo fornecedor
ASTER_API_BASE_URL=
ASTER_API_TOKEN=

# render para o backend

# Hostgator para o frontend
