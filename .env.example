# ============================================================
# ABR Intelligence - variaveis de ambiente
# Arquitetura atual:
# - Negocio/Core: Neon
# - Mercado: Neon separado
# - Atendimento/CRM: Supabase2
# - Brutos/arquivos: Google Drive
# ============================================================

# ------------------------------------------------------------
# Frontend publico
# ------------------------------------------------------------
# Chave publica do backend ABR. Esta pode ir para o Vite.
VITE_ABR_API_KEY=
# Opcional: deixe vazio quando frontend e backend rodam na mesma origem do Render.
VITE_ABR_API_BASE_URL=

# CRM/Atendimento no Supabase2. Estas chaves sao publicaveis.
VITE_SUPABASE_CRM_URL=
VITE_SUPABASE_CRM_PUBLISHABLE_KEY=

# Compatibilidade temporaria. Nao use Postgres direto no navegador.
# O frontend deve consultar o backend, e o backend acessa o Neon.
VITE_DATABASE_NEON_URL=
VITE_DATABASE_NEON_URL_POOLER=

# ------------------------------------------------------------
# Backend API / Render
# ------------------------------------------------------------
ABR_API_KEY=
ABR_DASHBOARD_PASSWORD=
ABR_SESSION_SECRET=

# Atualizacao diaria sem Cron pago:
# true = primeira abertura do dashboard no dia dispara a coleta D-1; depois so manual.
ABR_ENABLE_WEB_AUTO_REFRESH=true
ABR_ENABLE_WEB_REFRESH_JOBS=true
ABR_AUTO_REFRESH_START_DELAY_SECONDS=20
ABR_AUTO_REFRESH_CHECK_SECONDS=1800
ABR_CORE_PROBE_TIMEOUT_SECONDS=3

# ------------------------------------------------------------
# Neon Core - Negocio/Empresa
# Substitui o Supabase1 como banco vivo da aba Negocio.
# ------------------------------------------------------------
# Recomendado: usar a pooled URL para o app/Render.
DATABASE_NEON_URL=
DATABASE_NEON_URL_POOLER=

# Legado Supabase1. Manter vazio quando o Neon Core estiver configurado.
DATABASE_URL=
DATABASE_URL_POOLER=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_PASSWORD=

# ------------------------------------------------------------
# Neon Mercado
# Banco separado para a aba Mercado.
# ------------------------------------------------------------
DATABASE_MARKET_URL=
DATABASE_MARKET_URL_POOLER=

# ------------------------------------------------------------
# Supabase2 - CRM/Atendimento
# ------------------------------------------------------------
SUPABASE_CRM_URL=
SUPABASE_CRM_PUBLISHABLE_KEY=
SUPABASE_CRM_SECRET_KEY=
SUPABASE_CRM_JWKS_URL=
DATABASE_CRM_URL=
DATABASE_CRM_URL_POOLER=
SUPABASE_CRM_PASSWORD=

# ------------------------------------------------------------
# Aster - usar apenas no backend/coletor
# ------------------------------------------------------------
ASTER_BASE_URL=https://aster.gruposps.com.br/Login/abr
ASTER_LOGIN_EMAIL=
ASTER_LOGIN_PASSWORD=
HEADLESS=true

# Ingestao ABR para coletor Python/extensao Aster.
# Agora aponta para o FastAPI no Render, nao para Edge Function do Supabase1.
ABR_INGEST_URL=https://<render-service>.onrender.com/v1/collector/ingest
ABR_COLLECTOR_KEY=
ABR_ASTER_FONTE_ID=
ABR_ASTER_ENTIDADE=aster_relatorio

# Opcional: endpoint/segredo da integracao oficial do Aster, quando disponibilizado pelo fornecedor.
ASTER_API_BASE_URL=
ASTER_API_TOKEN=

# ------------------------------------------------------------
# Google Drive / OAuth / Archive
# ------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Service account e opcional. Em Meu Drive pessoal, OAuth e o caminho recomendado.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# Archive bruto - Google Drive
ARCHIVE_STORAGE_PROVIDER=google_drive
ARCHIVE_LOCAL_DIR=archive
ARCHIVE_WRITE_LOCAL_COPY=true
ARCHIVE_FAIL_ON_DRIVE_ERROR=false
ARCHIVE_GOOGLE_DRIVE_FOLDER_ID=1Tgc2ea8hdNgo9ReLT04bAT2PSvzsmR8W
ARCHIVE_GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1Tgc2ea8hdNgo9ReLT04bAT2PSvzsmR8W

# Pasta de entrada das planilhas brutas mais atuais:
# margem, gestao da producao, estoque, envelhecimento de estoque e cotacoes.
DRIVE_SPREADSHEET_SOURCE_FOLDER_ID=1e-ZFOdh5PpIOjX1xFU87uhIKHveL5EpU
DRIVE_SPREADSHEET_SOURCE_FOLDER_URL=https://drive.google.com/drive/folders/1e-ZFOdh5PpIOjX1xFU87uhIKHveL5EpU
DRIVE_SPREADSHEET_SCAN_DEPTH=1
# Mantem falso no plano gratis: bruto fica no Drive e banco recebe controle/fatos compactos.
DRIVE_SPREADSHEET_STORE_RAW_ROWS=false

# Planilha de ingestao secundaria
GOOGLE_SHEETS_SECUNDARIA=
GOOGLE_SHEETS_TOKEN=

# Planilha de ranking
PLANILHA_RANKING_URL=

# ------------------------------------------------------------
# Fontes externas - Mercado, macroeconomia e governo
# ------------------------------------------------------------
EXTERNAL_DATA_USER_AGENT=ABR-Intelligence/1.0
EXTERNAL_DATA_TIMEOUT_SECONDS=30

# BCB dolar/PTAX - API OData publica
BCB_DOLAR_API_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata

# IBGE PIM / Construcao - API SIDRA publica
IBGE_SIDRA_VALUES_BASE_URL=https://apisidra.ibge.gov.br/values
IBGE_SIDRA_DESCRIPTOR_BASE_URL=https://apisidra.ibge.gov.br/DescritoresTabela/t
IBGE_PIM_TABLE_ID=8888
IBGE_PIM_DEFAULT_PATH=/n1/all/v/12606/p/last%2036/c544/all
IBGE_CONSTRUCTION_TABLE_ID=8886
IBGE_CONSTRUCTION_DEFAULT_PATH=/n1/all/v/12606/p/last%2036

# ANEEL - Dados abertos / Parquet / API
ANEEL_API_BASE_URL=https://dadosabertos.aneel.gov.br
ANEEL_PARQUET_BASE_URL=
ANEEL_API_TOKEN=
# Granularidade gravada no banco de Mercado para manter o Neon leve.
ANEEL_DB_GRAIN=uf

# Comex Stat - CSV/exportacao
COMEX_STAT_API_BASE_URL=https://api-comexstat.mdic.gov.br
COMEX_STAT_CSV_BASE_URL=https://balanca.mdic.gov.br/balanca/bd/comexstat-bd/ncm
COMEX_STAT_API_TOKEN=

# Aco Brasil - download/scraping publico
ACO_BRASIL_DOWNLOAD_URL=https://www.acobrasil.org.br/site/estatistica-mensal/
ACO_BRASIL_PAGE_URL=https://www.acobrasil.org.br/site/estatistica-mensal/

# CNI Industria/Construcao - scraping de paginas publicas
CNI_INDUSTRIA_PAGE_URL=https://www.portaldaindustria.com.br/estatisticas/sondagem-industrial/
CNI_CONSTRUCAO_PAGE_URL=https://www.portaldaindustria.com.br/estatisticas/sondagem-industria-da-construcao/

# INDA - HTML publico
INDA_HTML_URL=https://www.inda.org.br/estatisticas/
INDA_PAGE_URL=https://www.inda.org.br/estatisticas/

# Caged - microdados
CAGED_MICRODADOS_BASE_URL=ftp://ftp.mtps.gov.br/pdet/microdados/

# PNCP - API publica
PNCP_API_BASE_URL=https://pncp.gov.br/api/consulta/v1

# World Bank - API publica WDI
WORLD_BANK_API_BASE_URL=https://api.worldbank.org/v2
WORLD_BANK_COUNTRIES=BRA;CHN;USA;WLD
WORLD_BANK_INDICATORS=NY.GDP.MKTP.KD.ZG;NV.IND.TOTL.KD.ZG;NV.IND.MANF.KD.ZG;NE.EXP.GNFS.KD.ZG;NE.IMP.GNFS.KD.ZG
WORLD_BANK_START_YEAR=2000

# ObrasGov - API publica
OBRASGOV_API_BASE_URL=https://api-publica.obrasgov.gestao.gov.br/obras
OBRASGOV_YEARS=2026
OBRASGOV_PAGE_SIZE=200
OBRASGOV_MAX_PAGES=25

