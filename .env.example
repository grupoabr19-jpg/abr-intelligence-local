# Supabase - frontend/publico
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase - backend/servicos
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Supabase - Postgres
# Use o Transaction Pooler IPv4 do Dashboard do Supabase.
# O host direto db.<project-ref>.supabase.co depende de IPv6 em alguns planos/redes.
# Exemplo de formato recomendado:
# DATABASE_URL_POOLER=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL_POOLER=
# Opcional: pode ser a URL direta do Dashboard; os scripts montam o pooler IPv4 a partir dela.
DATABASE_URL=
SUPABASE_PASSWORD=

# Aster - usar apenas no backend/coletor, nunca no frontend
ASTER_BASE_URL=https://aster.gruposps.com.br/Login/abr
ASTER_LOGIN_EMAIL=
ASTER_LOGIN_PASSWORD=
HEADLESS=true

# Ingestao ABR para coletor Python/extensao Aster
# URL padrao depois do deploy da Edge Function abr-collector-ingest.
ABR_INGEST_URL=https://<project-ref>.supabase.co/functions/v1/abr-collector-ingest
# Chave longa gerada por voce e cadastrada tambem como secret da Edge Function.
ABR_COLLECTOR_KEY=
# Fonte seedada pela migration para ASTER ERP (SPS Group):
# a0000000-0000-4000-8000-000000000001
ABR_ASTER_FONTE_ID=
ABR_ASTER_ENTIDADE=aster_relatorio

# API backend FastAPI
# Se preenchida, toda rota /v1 exige header: x-api-key: <valor>
ABR_API_KEY=
# Chave opcional para clientes server-to-server que leem somente o dashboard.
ABR_DASHBOARD_READ_KEY=
# Senha usada na tela de login do dashboard. Nao vai para o frontend.
ABR_DASHBOARD_PASSWORD=
# Segredo para assinar cookie de sessao do dashboard. Se vazio, usa ABR_API_KEY.
ABR_SESSION_SECRET=
PORT=8000

# Fontes externas - mercado, macroeconomia e governo
# Use apenas no backend/coletor. A maioria e publica; tokens ficam vazios ate haver fornecedor/chave.
EXTERNAL_DATA_USER_AGENT=ABR-Intelligence/1.0
EXTERNAL_DATA_TIMEOUT_SECONDS=60

# BCB dolar/PTAX - API OData publica, sem token
BCB_DOLAR_API_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata
BCB_DOLAR_API_DOCS_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/documentacao

# IBGE PIM - API SIDRA publica, sem token
IBGE_SIDRA_VALUES_BASE_URL=https://apisidra.ibge.gov.br/values
IBGE_SIDRA_DESCRIPTOR_BASE_URL=https://apisidra.ibge.gov.br/DescritoresTabela/t
IBGE_PIM_TABLE_ID=
IBGE_PIM_DEFAULT_PATH=

# ANEEL - Dados abertos / Parquet / API
ANEEL_API_BASE_URL=https://dadosabertos.aneel.gov.br
ANEEL_PARQUET_BASE_URL=
ANEEL_API_TOKEN=

# Comex Stat - CSV/exportacao
COMEX_STAT_CSV_BASE_URL=
COMEX_STAT_API_TOKEN=

# Aco Brasil - scraping de pagina publica
ACO_BRASIL_PAGE_URL=https://www.acobrasil.org.br/site/estatistica-mensal/
ACO_BRASIL_DOWNLOAD_URL=

# CNI Industria/Construcao - scraping de paginas publicas
CNI_INDUSTRIA_PAGE_URL=https://www.portaldaindustria.com.br/estatisticas/sondagem-industrial/
CNI_CONSTRUCAO_PAGE_URL=https://www.portaldaindustria.com.br/estatisticas/sondagem-industria-da-construcao/
CNI_INDUSTRIA_DOWNLOAD_URL=
CNI_CONSTRUCAO_DOWNLOAD_URL=

# INDA - HTML publico
INDA_PAGE_URL=https://www.inda.org.br/estatisticas/
INDA_HTML_URL=

# Caged - microdados
CAGED_MICRODADOS_BASE_URL=
CAGED_API_TOKEN=

# PNCP - API publica
PNCP_API_BASE_URL=https://pncp.gov.br/api/consulta/v1
PNCP_API_TOKEN=

# ObrasGov - API
OBRASGOV_API_BASE_URL=
OBRASGOV_API_TOKEN=

# World Bank - API
WORLD_BANK_API_BASE_URL=https://api.worldbank.org/v2
WORLD_BANK_API_TOKEN=

# ABRAMAT - download/API
ABRAMAT_DOWNLOAD_URL=
ABRAMAT_API_TOKEN=

# ANFAVEA - download/API
ANFAVEA_DOWNLOAD_URL=
ANFAVEA_API_TOKEN=

# Atendimento - Kommo / Google Sheets
# Use nomes ASCII em variaveis de ambiente para evitar problemas em shell/deploy.
KOMMO_ATENDIMENTO_SHEET_URL=https://docs.google.com/spreadsheets/d/1jAa3aSuIaSNvdeMC4_62M8vJS34-TWeZxneTfq0G5dg/edit?usp=sharing
KOMMO_ATENDIMENTO_SHEET_ID=1jAa3aSuIaSNvdeMC4_62M8vJS34-TWeZxneTfq0G5dg
KOMMO_ATENDIMENTO_SHEET_GID=0
KOMMO_ATENDIMENTO_EXPORT_CSV_URL=https://docs.google.com/spreadsheets/d/1jAa3aSuIaSNvdeMC4_62M8vJS34-TWeZxneTfq0G5dg/export?format=csv

# Opcional: endpoint/segredo da integracao oficial, quando disponibilizado pelo fornecedor
ASTER_API_BASE_URL=
ASTER_API_TOKEN=

