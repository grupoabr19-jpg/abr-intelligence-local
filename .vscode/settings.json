{
  "files.exclude": {
    "archive": true,
    "data/input": true,
    "Planilhas": true,
    ".auth": true,
    ".tools": true,
    ".venv": true,
    "frontend/dist": true,
    "frontend/node_modules": true,
    "docs/evidence": true,
    "docs/reference": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    "**/*.tsbuildinfo": true
  },
  "search.exclude": {
    "archive": true,
    "data/input": true,
    "Planilhas": true,
    ".auth": true,
    ".tools": true,
    ".venv": true,
    "frontend/dist": true,
    "frontend/node_modules": true,
    "docs/evidence": true,
    "docs/reference": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true
  },
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.auth/**": true,
    "**/.tools/**": true,
    "**/.venv/**": true,
    "**/archive/**": true,
    "**/data/input/**": true,
    "**/Planilhas/**": true,
    "**/docs/evidence/**": true,
    "**/docs/reference/**": true,
    "**/frontend/dist/**": true,
    "**/frontend/node_modules/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true
  },
  "typescript.validate.enable": false,
  "javascript.validate.enable": false,
  "python.analysis.exclude": [
    "archive",
    "data/input",
    "Planilhas",
    ".auth",
    ".tools",
    ".venv",
    "frontend/dist",
    "frontend/node_modules",
    "docs/evidence",
    "docs/reference",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache"
  ],
  "python.analysis.extraPaths": [
    "."
  ]
}
